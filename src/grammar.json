        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "data_constructor"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "|"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "data_constructor"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "data_constructor": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
