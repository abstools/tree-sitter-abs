          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "parameters",
              "content": {
                "type": "SYMBOL",
                "name": "data_constructor_parameters"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "data_constructor_parameters": {
      "type": "SEQ",
      "members": [
        {
