{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "abs",
      "camelcase": "ABS",
      "title": "ABS",
      "scope": "source.abs",
      "file-types": [
        "abs"
      ],
      "injection-regex": "^abs$",
      "class-name": "TreeSitterAbs"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "ABS grammar for tree-sitter",
    "authors": [
      {
        "name": "Sebastian Aschim Wilt",
        "email": "wilt.sebastian@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-abs"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}